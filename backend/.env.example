# POSTGRES_PASSWORD muss identisch mit dem POSTGRES_PASSWORD unten sein.
DATABASE_URL=postgresql+asyncpg://absenzdash:changeme@postgres:5432/absenzdash
# Muss gesetzt sein, sonst schlaegt der Start von docker-compose fehl (Fail-Fast).
POSTGRES_PASSWORD=changeme
# WICHTIG: echtes Secret generieren, z.B. mit "openssl rand -hex 32" — "changeme" wird vom Backend beim Start abgelehnt.
WORDPRESS_PROXY_SECRET=changeme
WEBUNTIS_SERVER=changeme.webuntis.com
WEBUNTIS_SCHOOL=changeme
WEBUNTIS_USERNAME=changeme
WEBUNTIS_PASSWORD=changeme
ASV_CSV_PATH=/data/asv-export/schueler.csv
ASV_CSV_ARCHIVE_DIR=/data/asv-csv-archiv
SMTP_HOST=changeme
SMTP_PORT=587
SMTP_FROM_ADDRESS=absenzdash@changeme.de
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=true
DASHBOARD_BASE_URL=http://localhost:3000
# DOCS_ENABLED=true  # nur fuer lokale Entwicklung, niemals in Produktion setzen
